# ---- Database ----
# Local dev can use SQLite (no server needed). Production on Vercel must use
# a managed Postgres connection string. The build scripts generate the matching
# Prisma datasource provider from this URL.
DATABASE_URL="file:./dev.db"

# ---- Auth (Auth.js / NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Contact / email ----
ADMIN_EMAIL="rukayat@rugabdynamic.com"
# Required only when running `npm run db:seed:admin`
ADMIN_PASSWORD=""
ADMIN_NAME="Rugab Admin"
ADMIN_PHONE=""
EMAIL_FROM="rukayat@rugabdynamic.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# ---- Payments (placeholder for Phase 3) ----
PAYSTACK_SECRET_KEY=""

# ---- Uploads (proof of delivery, Phase 2) ----
UPLOAD_PROVIDER="local"
UPLOADTHING_TOKEN=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
