# ---- Database ----
# Local dev uses SQLite (no server needed). For production, switch the
# datasource provider in prisma/schema.prisma to "postgresql" and use a
# Postgres connection string here.
DATABASE_URL="file:./dev.db"

# ---- Auth (Auth.js / NextAuth v5) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Contact / email ----
ADMIN_EMAIL="info@rugabdynamiclogistics.com"
EMAIL_FROM="info@rugabdynamiclogistics.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# ---- Payments (placeholder for Phase 3) ----
PAYSTACK_SECRET_KEY=""

# ---- Uploads (proof of delivery, Phase 2) ----
UPLOAD_PROVIDER="local"
UPLOADTHING_TOKEN=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
